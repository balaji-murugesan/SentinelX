{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
   "env": {
    "TEST_REDIS_URL": "redis://localhost:6380/15"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run lint-imports *)",
      "Bash(openspec validate *)",
      "Bash(openspec list *)",
      "Bash(openspec show *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(echo *)",
      "Bash(TEST_REDIS_URL=redis://localhost:6380/15 uv run pytest *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker start sx-*)",
      "Bash(docker exec sx-*)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh auth status)",
      "Bash(uv run *)",
      "Bash(docker compose *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git ls-tree *)",
      "Bash(git merge *)",
      "Bash(git switch *)",
      "Skill(openspec-apply-change)",
      "Skill(openspec-apply-change:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(*.env)",
      "Bash(*.env *)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(*DHAN_ACCESS_TOKEN*)",
      "Bash(docker compose config*)",
      "Bash(docker inspect *)",
      "Bash(docker exec * env*)",
      "Bash(docker compose exec * env*)",
      "Bash(gh auth token*)",
      "Bash(gh auth login*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth refresh*)",
      "Bash(*TRADING_MODE=live*)",
      "Bash(*LIVE_CONFIRM=yes*)",
      "Bash(*cli order place*)",
      "Bash(*cli order cancel*)",
      "Bash(*cli recovery resume*)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)",
      "Bash(Remove-Item * -Recurse*)"
    ],
    "ask": [
      "Bash(git checkout -- *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(docker kill *)"
    ]
  }
  
}
