# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Local run:  uv run --env-file .env python -m engine.main

# --- Trading mode (see docs: paper is the default) -----------------------------------
# Leave TRADING_MODE empty or "paper" for simulated fills against live prices.
# Live trading needs BOTH TRADING_MODE=live AND LIVE_CONFIRM=yes, typed exactly.
# Any other value (Live, true, prod, ...) makes the service refuse to start.
TRADING_MODE=paper
LIVE_CONFIRM=

# --- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Tracing: OpenTelemetry collector (OTLP/gRPC). Empty = do not export. ------------
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Redis (engine <-> api messaging) ---------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Database passwords (docker compose) -------------------------------------------
# Three DIFFERENT passwords, at least 16 characters, URL-safe (letters and digits only).
# Generate each with:  openssl rand -hex 24
# POSTGRES_PASSWORD:   bootstrap superuser, used only to initialise the database.
# ENGINE_DB_PASSWORD:  the engine's role (data read/write only).
# MIGRATE_DB_PASSWORD: the schema-owning role, used only by the one-shot migrate service.
# The database is initialised once; changing these later does not change existing roles.
POSTGRES_PASSWORD=
ENGINE_DB_PASSWORD=
MIGRATE_DB_PASSWORD=

# --- Running outside Docker (uv run --env-file .env python -m engine.main) ----------
# Compose builds these URLs itself from the passwords above; set them only for local runs.
DATABASE_URL=postgresql+asyncpg://sentinelx_engine:change-me@localhost:5432/sentinelx
MIGRATE_DATABASE_URL=postgresql+asyncpg://sentinelx_migrate:change-me@localhost:5432/sentinelx

# ---- Market data (add-market-data) ----
# Feed source: dhan (real prices) or simulated (dev/CI only; refused in live mode). No default on purpose.
FEED_SOURCE=simulated
# Instruments streamed at startup: comma-separated SEGMENT:SECURITY_ID
# (find IDs with `python -m cli instruments search`). IDX_I:13 = NIFTY 50 index.
FEED_INSTRUMENTS=IDX_I:13
# Hard cap on streamed instruments (Dhan max 5000).
FEED_MAX_SUBSCRIPTIONS=200
# Needed only with FEED_SOURCE=dhan. Paste a fresh token from web.dhan.co each day (valid ~24 h).
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ---- Candles (add-candles) -------------------------------------------------
# All optional; the values shown are the defaults.
# Candle intervals in minutes, anchored to the 09:15 IST open.
# Allowed: 1, 3, 5, 15 (they divide the 375-minute session exactly).
# CANDLE_INTERVALS=1,3,5,15
# Completed candles kept per instrument and interval (also the warm-up target).
# CANDLE_HISTORY=200
# Seconds after an interval ends before its candle closes (lets late ticks land).
# CANDLE_CLOSE_GRACE_S=2
# Dhan intraday-history requests started per second (Dhan's data-API limit is 5/s).
# DHAN_HISTORY_RATE_PER_S=4

CANDLE_INTERVALS=
CANDLE_HISTORY=
CANDLE_CLOSE_GRACE_S=
DHAN_HISTORY_RATE_PER_S=